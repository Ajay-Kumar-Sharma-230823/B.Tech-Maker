# B.Tech Maker – Google Sheets registration endpoint
# Copy this file to .env.local for local development. In Netlify, add the same
# key in Site configuration → Environment variables, then redeploy.
#
# This URL is public by design; it is not a credential. Keep the Google Sheet
# itself private and never place an Apps Script OAuth token or Sheet ID here.
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Public Turnstile site key. The matching secret stays only in the Apps Script
# project's Script properties as TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY

# Public privacy-notice values. Use a monitored mailbox and set the same
# retention period in Apps Script Script properties as REGISTRATION_RETENTION_DAYS.
VITE_PRIVACY_CONTACT_EMAIL=privacy@yourdomain.example
VITE_REGISTRATION_RETENTION_DAYS=365
VITE_SITE_ORIGIN=https://www.yourdomain.example
