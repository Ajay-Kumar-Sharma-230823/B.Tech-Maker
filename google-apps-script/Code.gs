/**
 * B.Tech Maker registration receiver
 *
 * Create this as a script bound to the registrations Google Sheet. Before
 * deploying, set Script property ALLOWED_ORIGIN to the exact public site
 * origin, for example: https://your-site.netlify.app
 */

const REGISTRATIONS_SHEET_NAME = 'Registrations';
const REGISTRATION_HEADERS = [
  'Registration ID',
  'Submission Date',
  'Submission Time',
  'Full Name',
  'Course',
  'Branch',
  'Contact Number',
  'Email Address',
  'Suggestions / Feedback',
];

const RESULT_MESSAGE_TYPE = 'btech-maker-registration-result';
const REGISTRATION_STATUS_PREFIX = 'btech-maker-registration-status:';
const REGISTRATION_RATE_LIMIT_PREFIX = 'btech-maker-registration-rate-limit:';
const REGISTRATION_RATE_LIMIT_SECONDS = 10 * 60;
const TURNSTILE_VERIFY_URL = 'https://challenges.cloudflare.com/turnstile/v0/siteverify';
const TURNSTILE_EXPECTED_ACTION = 'early_access_registration';

/**
 * Run once from the Apps Script editor after creating the Sheet. It creates
 * the Registrations tab (if needed), writes the headings, and formats them.
 */
function setupRegistrationSheet() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = spreadsheet.getSheetByName(REGISTRATIONS_SHEET_NAME);
  if (!sheet) sheet = spreadsheet.insertSheet(REGISTRATIONS_SHEET_NAME);

  const currentHeadings = sheet.getRange(1, 1, 1, REGISTRATION_HEADERS.length).getValues()[0];
  if (!currentHeadings.some(String)) {
    sheet.getRange(1, 1, 1, REGISTRATION_HEADERS.length).setValues([REGISTRATION_HEADERS]);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, REGISTRATION_HEADERS.length)
      .setFontWeight('bold')
      .setBackground('#1f2937')
      .setFontColor('#ffffff');
    sheet.autoResizeColumns(1, REGISTRATION_HEADERS.length);
  } else if (currentHeadings.join('\u0000') !== REGISTRATION_HEADERS.join('\u0000')) {
    throw new Error(`The first row of "${REGISTRATIONS_SHEET_NAME}" must contain the required registration headings.`);
  }

  return sheet;
}

/**
 * Accepts a browser form POST, appends one registration, then sends a
 * confirmation message to the requesting site only after the write succeeds.
 */
function doPost(event) {
  const requestId = getRequestId_(event);

  try {
    if (!requestId) throw new Error('Invalid registration data.');
    const allowedOrigin = getAllowedOrigin_();
    const registration = validateRegistration_(readRequest_(event));
    validateTurnstile_(registration.turnstileToken);
    const lock = LockService.getScriptLock();
    lock.waitLock(30000);

    try {
      enforceRegistrationRateLimit_(registration);
      const sheet = setupRegistrationSheet();
      const nextRow = sheet.getLastRow() + 1;
      const now = new Date();
      const timeZone = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();

      sheet.getRange(nextRow, 1, 1, REGISTRATION_HEADERS.length).setValues([[
        requestId,
        Utilities.formatDate(now, timeZone, 'yyyy-MM-dd'),
        Utilities.formatDate(now, timeZone, 'HH:mm:ss'),
        registration.name,
        registration.course,
        registration.branch,
        registration.contactNumber,
        registration.email,
        registration.suggestion,
      ]]);
      sheet.getRange(nextRow, 1, 1, 1).setNumberFormat('@');
      sheet.getRange(nextRow, 7, 1, 2).setNumberFormat('@');
      SpreadsheetApp.flush();
      storeRegistrationStatus_(requestId, { ok: true, message: 'Registration saved successfully.' });
    } finally {
      lock.releaseLock();
    }

    return resultPage_(allowedOrigin, requestId, true, 'Registration saved successfully.');
  } catch (_) {
    // Keep request contents and implementation details out of Apps Script logs.
    console.error('Registration submission failed.');
    storeRegistrationStatus_(requestId, { ok: false, message: 'We could not save your registration. Please try again.' });
    // Do not return internal details or spreadsheet identifiers to the browser.
    return resultPage_(getAllowedOriginOrEmpty_(), requestId, false, 'We could not save your registration. Please try again.');
  }
}

/**
 * Returns only a short-lived status for the request ID generated by the
 * browser. No registration details are exposed through this public route.
 */
function doGet(event) {
  const callback = String(event && event.parameter && event.parameter.callback || '');
  const requestId = String(event && event.parameter && event.parameter.requestId || '');
  const isStatusRequest = String(event && event.parameter && event.parameter.action || '') === 'status';

  if (!isStatusRequest || !/^[A-Za-z_$][A-Za-z0-9_$]{0,140}$/.test(callback) || !/^[A-Za-z0-9-]{1,100}$/.test(requestId)) {
    return ContentService.createTextOutput('Invalid status request.');
  }

  const cachedStatus = CacheService.getScriptCache().get(REGISTRATION_STATUS_PREFIX + requestId);
  const status = cachedStatus ? JSON.parse(cachedStatus) : { ok: false, pending: true };
  return ContentService.createTextOutput(`${callback}(${JSON.stringify(status)});`)
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function readRequest_(event) {
  if (event && event.parameter && Object.keys(event.parameter).length) return event.parameter;

  const contents = event && event.postData && event.postData.contents;
  if (!contents) throw new Error('Missing registration data.');
  const data = JSON.parse(contents);
  if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('Invalid registration data.');
  return data;
}

function getRequestId_(event) {
  const value = event && event.parameter && event.parameter.requestId;
  return typeof value === 'string' && /^[A-Za-z0-9-]{1,100}$/.test(value) ? value : '';
}

function storeRegistrationStatus_(requestId, status) {
  if (!requestId) return;
  CacheService.getScriptCache().put(
    REGISTRATION_STATUS_PREFIX + requestId,
    JSON.stringify(status),
    300,
  );
}

function validateRegistration_(data) {
  if (String(data.website || '').trim()) throw new Error('Invalid registration data.');
  const name = requiredText_(data.name, 'Full name', 120);
  const course = requiredText_(data.course, 'Course', 80);
  const branch = requiredText_(data.branch, 'Branch', 120);
  const contactNumber = String(data.contactNumber || '').replace(/[\s-]/g, '');
  const normalizedContactNumber = contactNumber.startsWith('+91') ? contactNumber.slice(3) : contactNumber;
  const email = String(data.email || '').trim().toLowerCase();
  const suggestion = optionalText_(data.suggestion, 1000);
  const turnstileToken = String(data.turnstileToken || '').trim();

  if (!/^(?:\+91)?[6-9]\d{9}$/.test(contactNumber)) throw new Error('Invalid contact number.');
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || email.length > 254) throw new Error('Invalid email address.');
  if (!turnstileToken || turnstileToken.length > 2048) throw new Error('Invalid security check.');

  return {
    name: sheetSafe_(name),
    course: sheetSafe_(course),
    branch: sheetSafe_(branch),
    contactNumber: sheetSafe_(normalizedContactNumber),
    email: sheetSafe_(email),
    suggestion: sheetSafe_(suggestion),
    turnstileToken,
  };
}

// The secret is stored only in Apps Script Script properties. The browser
// sends the short-lived token; this server-side check decides whether to save.
function validateTurnstile_(token) {
  const secret = PropertiesService.getScriptProperties().getProperty('TURNSTILE_SECRET_KEY');
  if (!secret) throw new Error('Registration service is not configured.');

  let verification;
  try {
    const response = UrlFetchApp.fetch(TURNSTILE_VERIFY_URL, {
      method: 'post',
      payload: { secret: secret, response: token },
      muteHttpExceptions: true,
    });
    if (response.getResponseCode() !== 200) throw new Error('Security verification failed.');
    verification = JSON.parse(response.getContentText());
  } catch (_) {
    throw new Error('Security verification failed.');
  }

  if (!verification || verification.success !== true || verification.action !== TURNSTILE_EXPECTED_ACTION) {
    throw new Error('Security verification failed.');
  }
}

// The Apps Script web-app endpoint is intentionally public for this form.
// Keep only a one-way SHA-256 digest in the shared cache so repeat submits for
// the same email/phone pair are throttled without retaining additional PII.
function enforceRegistrationRateLimit_(registration) {
  const fingerprint = `${registration.email}\u0000${registration.contactNumber}`;
  const digest = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, fingerprint, Utilities.Charset.UTF_8);
  const key = REGISTRATION_RATE_LIMIT_PREFIX + Utilities.base64EncodeWebSafe(digest).replace(/=+$/, '');
  const cache = CacheService.getScriptCache();
  if (cache.get(key)) throw new Error('Registration rate limit exceeded.');
  cache.put(key, '1', REGISTRATION_RATE_LIMIT_SECONDS);
}

function requiredText_(value, label, maximumLength) {
  const text = String(value || '').trim();
  if (!text) throw new Error(`${label} is required.`);
  if (text.length > maximumLength) throw new Error(`${label} is too long.`);
  return text;
}

function optionalText_(value, maximumLength) {
  const text = String(value || '').trim();
  if (text.length > maximumLength) throw new Error('Suggestion is too long.');
  return text;
}

// Prevent a user-provided value from becoming a formula in Google Sheets.
function sheetSafe_(value) {
  return /^[=+\-@]/.test(value) ? `'${value}` : value;
}

function getAllowedOrigin_() {
  const origin = PropertiesService.getScriptProperties().getProperty('ALLOWED_ORIGIN');
  const isPublicHttpsOrigin = /^https:\/\/[a-z0-9.-]+(?::\d+)?$/i.test(origin || '');
  const isLocalDevelopmentOrigin = /^http:\/\/(?:localhost|127\.0\.0\.1)(?::\d+)?$/i.test(origin || '');
  if (!origin || (!isPublicHttpsOrigin && !isLocalDevelopmentOrigin)) {
    throw new Error('ALLOWED_ORIGIN Script property is not configured.');
  }
  return origin;
}

function getAllowedOriginOrEmpty_() {
  try {
    return getAllowedOrigin_();
  } catch (_) {
    return '';
  }
}

function resultPage_(allowedOrigin, requestId, ok, message) {
  if (!allowedOrigin) {
    return HtmlService.createHtmlOutput('<!doctype html><title>Configuration error</title>');
  }

  const payload = JSON.stringify({ type: RESULT_MESSAGE_TYPE, requestId: requestId, ok: ok, message: message })
    .replace(/</g, '\\u003c');
  const targetOrigin = JSON.stringify(allowedOrigin).replace(/</g, '\\u003c');
  const html = `<!doctype html><html><body><script>window.top.postMessage(${payload}, ${targetOrigin});</script></body></html>`;

  return HtmlService.createHtmlOutput(html)
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}
